---
import '@/styles/global.css';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import SearchDialog from '@components/SearchDialog.astro';
import { SITE, canonical, clamp, graph, websiteLd, organisationLd, breadcrumbLd } from '@lib/seo';

interface Props {
  title: string;
  description: string;
  /** Path only, e.g. "/places/jaflong". Defaults to the current URL. */
  path?: string;
  /** Absolute or root-relative image path used for Open Graph. */
  image?: string;
  /** Extra JSON-LD nodes merged into the page @graph. */
  jsonLd?: Record<string, unknown>[];
  /** Breadcrumb trail; also rendered as JSON-LD. */
  breadcrumbs?: { name: string; href: string }[];
  /** Suppress the " · Ghuro Bangladesh" suffix (used on the homepage). */
  rawTitle?: boolean;
  /** Tell crawlers not to index (search results, favourites). */
  noindex?: boolean;
  /** Class applied to <body>, for page-specific styling hooks. */
  bodyClass?: string;
  /** Hide the sticky header shadow on pages with a full-bleed hero. */
  transparentHeader?: boolean;
}

const {
  title,
  description,
  path,
  image = '/images/og/default.png',
  jsonLd = [],
  breadcrumbs,
  rawTitle = false,
  noindex = false,
  bodyClass = '',
  transparentHeader = false,
} = Astro.props;

const pagePath = path ?? Astro.url.pathname;
const fullTitle = rawTitle ? title : `${title} · ${SITE.name}`;
const desc = clamp(description);
const canonicalUrl = canonical(pagePath);
const ogImage = new URL(image, SITE.url).href;

const nodes = [
  organisationLd(),
  websiteLd(),
  ...(breadcrumbs?.length ? [breadcrumbLd(breadcrumbs)] : []),
  ...jsonLd,
];
---

<!doctype html>
<html lang="en" prefix="og: https://ogp.me/ns#">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />

    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:locale:alternate" content="bn_BD" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="theme-color" content="#faf6ee" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a1614" media="(prefers-color-scheme: dark)" />
    <meta name="color-scheme" content="light dark" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    {/* Self-hosted fonts: preload only the two faces above the fold. */}
    <link rel="preload" href="/fonts/fraunces-latin-normal-3.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-latin-normal-1.woff2" as="font" type="font/woff2" crossorigin />

    {/* Theme is resolved before first paint to avoid a flash. */}
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('gb-theme');
          if (t === 'light' || t === 'dark') document.documentElement.setAttribute('data-theme', t);
        } catch (e) {}
        document.documentElement.classList.add('js');
      })();
    </script>

    <script type="application/ld+json" set:html={graph(nodes)} is:inline />

    <slot name="head" />
  </head>

  <body class={bodyClass}>
    <a href="#main" class="skip-link">Skip to content</a>
    <Header transparent={transparentHeader} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <SearchDialog />

    <script>
      import '@/scripts/app';
    </script>
  </body>
</html>
