---
import Base from '@/layouts/Base.astro';
import PageHero from '@components/PageHero.astro';
import PlaceCard from '@components/PlaceCard.astro';
import FilterBar from '@components/FilterBar.astro';
import Icon from '@components/Icon.astro';
import { places, stats, divisions } from '@data/index';
import { collectionLd } from '@lib/seo';

const trail = [
  { name: 'Home', href: '/' },
  { name: 'Explore', href: '/explore' },
];

const jsonLd = [
  collectionLd(
    'Every destination in Bangladesh',
    `All ${stats.places} destinations in the Ghuro Bangladesh atlas, filterable by division, category and interest.`,
    '/explore',
    places.map((p) => ({ name: p.name, slug: p.slug }))
  ),
];
---

<Base
  title="Explore every destination"
  description={`Browse all ${stats.places} destinations across Bangladesh — filter by division, category and interest, and sort by renown, name or district.`}
  path="/explore"
  breadcrumbs={trail}
  jsonLd={jsonLd}
>
  <PageHero
    eyebrow="The whole atlas"
    title="Every destination, all at once"
    lead={`${stats.places} places across ${stats.divisions} divisions and ${stats.districts} districts. Filter it down to what you actually want — or sort by "least visited first" and see what you have never heard of.`}
    trail={trail}
  >
    <ul class="explore-quick">
      {
        divisions.map((d) => (
          <li>
            <a href={`/divisions/${d.slug}`} class="chip">
              {d.name}
            </a>
          </li>
        ))
      }
    </ul>
  </PageHero>

  <div class="wrap">
    <FilterBar total={stats.places} />

    <h2 class="sr-only">All destinations</h2>
    <div class="grid-cards" data-filter-grid>
      {
        places.map((p, i) => (
          <div data-filter-item class="defer-paint">
            <PlaceCard place={p} loading={i < 12 ? 'eager' : 'lazy'} />
          </div>
        ))
      }
    </div>

    <div class="explore-empty" data-filter-empty hidden>
      <span class="explore-empty-icon">
        <Icon name="compass" size={26} />
      </span>
      <h2>No destinations match those filters</h2>
      <p>
        That combination is probably narrower than it looks — an archaeological site that is also a
        beach, for instance. Try removing one filter, or start from a division.
      </p>
      <div class="explore-empty-actions">
        <button type="button" class="btn btn-primary" data-filter-clear>Clear all filters</button>
        <a href="/discover" class="btn btn-ghost">
          <Icon name="compass" size={15} /> Use the discovery tool
        </a>
      </div>
    </div>
  </div>
</Base>

<style>
  .explore-quick {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    list-style: none;
    margin: 1.25rem 0 0;
    padding: 0;
  }

  .grid-cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
    gap: 1.25rem;
    padding-bottom: 3rem;
  }

  .explore-empty {
    max-width: 30rem;
    margin: 3rem auto 5rem;
    text-align: center;
  }
  .explore-empty-icon {
    display: inline-grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 50%;
    border: 1px solid var(--line);
    background: var(--bg-sunken);
    color: var(--fg-subtle);
    margin-bottom: 1rem;
  }
  .explore-empty h2 {
    font-size: 1.375rem;
    margin-bottom: 0.5rem;
  }
  .explore-empty p {
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--fg-muted);
    margin-bottom: 1.25rem;
  }
  .explore-empty-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    justify-content: center;
  }
</style>
