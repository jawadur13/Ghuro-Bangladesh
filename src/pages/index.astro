---
import Base from '@/layouts/Base.astro';
import SectionHead from '@components/SectionHead.astro';
import PlaceCard from '@components/PlaceCard.astro';
import DivisionCard from '@components/DivisionCard.astro';
import BangladeshMap from '@components/BangladeshMap.astro';
import Icon from '@components/Icon.astro';
import Art from '@components/Art.astro';
import {
  divisions,
  stats,
  featuredPlaces,
  hiddenGems,
  popularPlaces,
  collections,
  categories,
  featuredTags,
  seasons,
  places,
  getDistrict,
  placesInSeason,
} from '@data/index';
import { SITE, faqLd } from '@lib/seo';

/* ── Editorial selection for each homepage surface ─────────────────────── */

const heroPlace = places.find((p) => p.slug === 'sundarbans') ?? featuredPlaces[0];

const featured = featuredPlaces.filter((p) => p.slug !== heroPlace.slug).slice(0, 6);

const popular = popularPlaces.slice(0, 8);

const gems = hiddenGems
  .filter((p) => p.popularity >= 2)
  .sort((a, b) => b.popularity - a.popularity)
  .slice(0, 6);

/* The current month drives the seasonal band, so the homepage is never stale. */
const now = new Date();
const month = now.getMonth() + 1;
const currentSeason =
  seasons.find((s) => s.months.includes(month) && s.months.length <= 2) ??
  seasons.find((s) => s.months.includes(month))!;
const seasonalPicks = placesInSeason(currentSeason.slug)
  .sort((a, b) => b.popularity - a.popularity)
  .slice(0, 6);

const featuredCollections = collections.filter((c) => c.featured).slice(0, 4);

const categoryHighlights = [
  'beach', 'haor', 'archaeological', 'tea-garden', 'hill', 'mosque',
  'waterfall', 'temple', 'wildlife', 'island', 'zamindar-bari', 'market',
]
  .map((slug) => categories.find((c) => c.slug === slug))
  .filter((c): c is NonNullable<typeof c> => !!c);

const weekend = places
  .filter((p) => p.tags.includes('weekend') || p.tripLength === 'overnight')
  .sort((a, b) => b.popularity - a.popularity)
  .slice(0, 6);

/* ── Facts strip: specific, checkable, and not a brochure ─────────────── */
const facts = [
  {
    icon: 'water' as const,
    stat: '≈700',
    label: 'rivers',
    note: 'Bangladesh is a river system with land in between — the largest delta on earth.',
  },
  {
    icon: 'tree' as const,
    stat: '6,000 km²',
    label: 'of mangrove',
    note: 'The Bangladeshi Sundarbans: the largest contiguous mangrove forest in the world.',
  },
  {
    icon: 'mountain' as const,
    stat: '1',
    label: 'mountain region',
    note: 'Everything above 1,000 m is in the Chittagong Hill Tracts. The rest is delta.',
  },
  {
    icon: 'sunIcon' as const,
    stat: '6',
    label: 'seasons',
    note: 'The Bengali calendar counts six, not four — and travel here genuinely follows them.',
  },
];

const faqs = [
  {
    q: 'When is the best time to visit Bangladesh?',
    a: 'November to February — cool, dry and clear, with the best conditions for the Sundarbans, the Chittagong Hill Tracts and long walking days at archaeological sites. November is arguably the sweet spot: winter weather without the December–January crowds. The monsoon (June–September) is the only time to see the haors flooded, Ratargul swamp forest navigable and the waterfalls running.',
  },
  {
    q: 'How many UNESCO World Heritage Sites does Bangladesh have?',
    a: 'Three: the Sundarbans mangrove forest, the Historic Mosque City of Bagerhat, and the Buddhist Vihara at Paharpur (Somapura Mahavihara) in Naogaon.',
  },
  {
    q: 'Do I need a permit to travel in the Chittagong Hill Tracts?',
    a: 'Some areas of Bandarban, Rangamati and Khagrachhari require official permission, a registered local guide, or escorted convoy travel. Sajek is reached by convoy at fixed times; Thanchi and Ruma have been restricted at various points. Rules change, sometimes at short notice, so confirm the current position locally before booking.',
  },
  {
    q: 'What is the highest point in Bangladesh?',
    a: 'Officially Tazing Dong (Bijoy) in Bandarban, though repeated independent GPS surveys have measured Saka Haphong, near the Myanmar border, as higher. The dispute is unresolved. Keokradong, long cited as the highest, is lower than both but remains the most-climbed summit in the country.',
  },
  {
    q: 'Can you really see the Himalaya from Bangladesh?',
    a: 'Yes, from Tetulia in Panchagarh — the northernmost point of the country. Kanchenjunga, roughly 140 km away, is visible on genuinely clear mornings in October and November, usually only until about nine before haze closes it down.',
  },
];

const jsonLd = [faqLd(faqs)];
---

<Base
  title={`${SITE.name} — Discover Bangladesh, One Place at a Time`}
  description={`A field atlas of Bangladesh: ${stats.places} researched destinations across all 8 divisions and 64 districts, with honest travel notes, seasons, routes and an interactive map.`}
  path="/"
  rawTitle
  jsonLd={jsonLd}
  transparentHeader
  bodyClass="home"
>
  <!-- ═══════════════════════════ HERO ═══════════════════════════ -->
  <section class="hero grain" aria-labelledby="hero-title">
    <div class="hero-art">
      <Art
        art={heroPlace.art}
        alt=""
        loading="eager"
        priority
        ratio="16 / 9"
        class="hero-art-img"
      />
      <div class="hero-scrim"></div>
    </div>

    <div class="wrap hero-inner">
      <p class="hero-kicker">
        <span class="hero-dot" aria-hidden="true"></span>
        A field atlas of Bangladesh
      </p>

      <h1 id="hero-title" class="hero-title">
        Discover Bangladesh,<br /><em>one place at a time.</em>
      </h1>

      <p class="hero-lead">
        {stats.places} researched destinations across all {stats.divisions} divisions and
        {stats.districts} districts — the mangroves, the mountains, the terracotta temples and the
        floating markets. Written for people who are actually going.
      </p>

      <div class="hero-search">
        <button type="button" class="hero-search-btn" data-search-open>
          <Icon name="search" size={20} />
          <span>Search a place, district or category…</span>
          <kbd>/</kbd>
        </button>
      </div>

      <ul class="hero-chips">
        <li><a href="/discover" class="hero-chip hero-chip-accent">
          <Icon name="compass" size={15} /> Where should I go?
        </a></li>
        <li><a href="/map" class="hero-chip"><Icon name="map" size={15} /> Open the map</a></li>
        <li><a href="/collections/hidden-gems" class="hero-chip"><Icon name="sparkle" size={15} /> Hidden gems</a></li>
        <li><a href={`/seasons/${currentSeason.slug}`} class="hero-chip">
          <Icon name="calendar" size={15} /> Good right now
        </a></li>
      </ul>

      <dl class="hero-stats">
        <div><dt>Destinations</dt><dd class="tnum" data-count-to={stats.places}>0</dd></div>
        <div><dt>Districts</dt><dd class="tnum" data-count-to={stats.districts}>0</dd></div>
        <div><dt>Divisions</dt><dd class="tnum" data-count-to={stats.divisions}>0</dd></div>
        <div><dt>UNESCO sites</dt><dd class="tnum" data-count-to={stats.unesco}>0</dd></div>
      </dl>
    </div>

    <a href="#explore-map" class="hero-scroll" aria-label="Scroll to the map">
      <Icon name="chevronDown" size={20} />
    </a>
  </section>

  <!-- ═══════════════════════ MAP ═══════════════════════ -->
  <section class="section band-dark map-band" id="explore-map" aria-labelledby="map-title">
    <div class="wrap map-band-inner">
      <div class="map-band-text reveal">
        <p class="eyebrow">Start with the geography</p>
        <h2 id="map-title" class="map-band-title">
          Bangladesh is easier to understand from above.
        </h2>
        <p class="map-band-lead">
          Eight divisions, sixty-four districts. The shading shows where this atlas currently has the
          most to say — the hill districts and the north-east are dense, the western plains are
          quieter, and that is an honest picture of where the destinations are.
        </p>
        <ul class="map-band-list">
          {
            divisions.map((d) => (
              <li>
                <a href={`/divisions/${d.slug}`}>
                  <span class={`map-band-dot hue-${d.hue}`} aria-hidden="true" />
                  <span class="map-band-name">{d.name}</span>
                  <span class="map-band-count tnum">
                    {places.filter((p) => p.division === d.slug).length}
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
        <a href="/map" class="btn btn-primary">
          <Icon name="map" size={16} /> Explore the full map
        </a>
      </div>

      <div class="map-band-map reveal" data-reveal-delay="120">
        <BangladeshMap level="districts" height="auto" />
      </div>
    </div>
  </section>

  <!-- ═══════════════════════ FEATURED ═══════════════════════ -->
  <section class="section" aria-labelledby="featured-title">
    <div class="wrap">
      <SectionHead
        eyebrow="Start here"
        title="The ones you should not miss"
        lead="If you only take a handful of trips in Bangladesh, take these. Each one is genuinely unlike the others."
        href="/explore"
        linkLabel="All destinations"
      />
      <div class="grid-cards">
        {featured.map((p, i) => (
          <div class="reveal" data-reveal-delay={i * 60}>
            <PlaceCard place={p} loading={i < 3 ? 'eager' : 'lazy'} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════ DIVISIONS ═══════════════════════ -->
  <section class="section section-tight" aria-labelledby="divisions-title">
    <div class="wrap">
      <SectionHead
        eyebrow="Explore by region"
        title="Eight divisions, eight different countries"
        lead="The delta in the south-west, mountains in the south-east, archaeology in the north-west, tea and wetland in the north-east. Bangladesh is small and it is not uniform."
        href="/divisions"
        linkLabel="All divisions"
      />
      <div class="grid-divisions">
        {divisions.map((d, i) => (
          <div class="reveal" data-reveal-delay={(i % 4) * 60}>
            <DivisionCard division={d} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════ SEASONAL ═══════════════════════ -->
  <section class="section season-band" aria-labelledby="season-title">
    <div class="wrap">
      <SectionHead
        eyebrow={`It is ${currentSeason.name.toLowerCase()} — ${currentSeason.bengaliSeason}`}
        title={currentSeason.tagline}
        lead={currentSeason.description}
        href={`/seasons/${currentSeason.slug}`}
        linkLabel="More for this season"
      />

      <div class="season-grid">
        <div class="season-notes reveal">
          <div class="season-note season-good">
            <h3><Icon name="check" size={16} /> Good for right now</h3>
            <ul>{currentSeason.goodFor.slice(0, 4).map((g) => <li>{g}</li>)}</ul>
          </div>
          <div class="season-note season-watch">
            <h3><Icon name="alert" size={16} /> Worth knowing</h3>
            <ul>{currentSeason.watchOut.slice(0, 3).map((g) => <li>{g}</li>)}</ul>
          </div>
        </div>

        <div class="season-rail-wrap reveal" data-reveal-delay="100">
          <div class="rail season-rail">
            {seasonalPicks.map((p) => <PlaceCard place={p} variant="compact" />)}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════ HIDDEN GEMS ═══════════════════════ -->
  <section class="section band-dark gems-band" aria-labelledby="gems-title">
    <div class="wrap">
      <SectionHead
        eyebrow="Under-visited"
        title="Places almost nobody goes"
        lead="Bangladeshi tourism concentrates on a very short list. These are not obscure because they are second-rate — they are obscure because nobody has told you about them."
        href="/collections/hidden-gems"
        linkLabel="The full list"
      />
      <div class="grid-cards">
        {gems.map((p, i) => (
          <div class="reveal" data-reveal-delay={i * 60}>
            <PlaceCard place={p} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════ COLLECTIONS ═══════════════════════ -->
  <section class="section" aria-labelledby="collections-title">
    <div class="wrap">
      <SectionHead
        eyebrow="Curated routes"
        title="Trips worth building a holiday around"
        lead="Themed routes and collections assembled from the atlas — a terracotta trail across the north-west, a monsoon-only itinerary, ten days along the whole coast."
        href="/collections"
        linkLabel="All collections"
      />
      <div class="grid-collections">
        {
          featuredCollections.map((c, i) => (
            <article class="ccard reveal" data-reveal-delay={i * 60}>
              <div class="ccard-media">
                <Art art={c.art} alt="" ratio="16 / 9" />
                <div class="ccard-scrim" />
                {c.days && <span class="ccard-days">{c.days} days</span>}
              </div>
              <div class="ccard-body">
                <h3 class="ccard-title">
                  <a href={`/collections/${c.slug}`} class="stretch">
                    {c.title}
                  </a>
                </h3>
                <p class="ccard-tagline">{c.tagline}</p>
                <p class="ccard-count">
                  <Icon name="route" size={14} />
                  {c.places.length} places
                </p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ═══════════════════════ CATEGORIES ═══════════════════════ -->
  <section class="section section-tight" aria-labelledby="cats-title">
    <div class="wrap">
      <SectionHead
        eyebrow="Browse by kind"
        title="What are you actually looking for?"
        href="/categories"
        linkLabel="All categories"
      />
      <div class="grid-categories">
        {
          categoryHighlights.map((c, i) => (
            <a href={`/categories/${c.slug}`} class="catcard reveal" data-reveal-delay={(i % 6) * 40}>
              <span class="catcard-icon">
                <Icon name={c.icon} size={20} />
              </span>
              <span class="catcard-text">
                <span class="catcard-name">{c.name}</span>
                <span class="catcard-bn bn" lang="bn">
                  {c.nameBn}
                </span>
              </span>
              <Icon name="arrowRight" size={16} class="catcard-arrow" />
            </a>
          ))
        }
      </div>

      <div class="interest-row">
        <p class="interest-label">Or by interest</p>
        <ul class="interest-chips">
          {featuredTags.map((t) => <li><a href={`/tags/${t.slug}`} class="chip">{t.name}</a></li>)}
        </ul>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════ WEEKEND ═══════════════════════ -->
  <section class="section" aria-labelledby="weekend-title">
    <div class="wrap">
      <SectionHead
        eyebrow="Two days is enough"
        title="Weekend trips"
        lead="Places that genuinely repay one night away — most of them reachable from a major city in under four hours."
        href="/tags/weekend"
        linkLabel="More weekend trips"
      />
      <div class="rail">
        {weekend.map((p) => <PlaceCard place={p} variant="compact" />)}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════ FACTS ═══════════════════════ -->
  <section class="section facts-band topo" aria-labelledby="facts-title">
    <div class="wrap">
      <SectionHead
        center
        eyebrow="Context"
        title="Four things that explain the whole country"
      />
      <div class="facts-grid">
        {
          facts.map((f, i) => (
            <div class="fact reveal" data-reveal-delay={i * 70}>
              <span class="fact-icon">
                <Icon name={f.icon} size={22} />
              </span>
              <p class="fact-stat">{f.stat}</p>
              <p class="fact-label">{f.label}</p>
              <p class="fact-note">{f.note}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ═══════════════════════ POPULAR ═══════════════════════ -->
  <section class="section section-tight" aria-labelledby="popular-title">
    <div class="wrap">
      <SectionHead
        eyebrow="Best known"
        title="The places every Bangladeshi can name"
        href="/explore?sort=popular"
        linkLabel="Sorted by renown"
      />
      <ol class="popular-list">
        {
          popular.map((p, i) => {
            const district = getDistrict(p.district);
            return (
              <li class="reveal" data-reveal-delay={(i % 4) * 50}>
                <a href={`/places/${p.slug}`} class="popular-item">
                  <span class="popular-rank tnum">{String(i + 1).padStart(2, '0')}</span>
                  <Art art={p.art} alt="" ratio="1 / 1" class="popular-art" />
                  <span class="popular-text">
                    <span class="popular-name">{p.name}</span>
                    <span class="popular-where">{district?.name}</span>
                  </span>
                  <Icon name="arrowUpRight" size={16} class="popular-arrow" />
                </a>
              </li>
            );
          })
        }
      </ol>
    </div>
  </section>

  <!-- ═══════════════════════ FAQ ═══════════════════════ -->
  <section class="section faq-band" aria-labelledby="faq-title">
    <div class="wrap-narrow">
      <SectionHead
        eyebrow="Before you go"
        title="Questions people actually ask"
        as="h2"
      />
      <div class="faq-list">
        {
          faqs.map((f) => (
            <details class="faq-item">
              <summary>
                <span>{f.q}</span>
                <Icon name="plus" size={17} class="faq-plus" />
                <Icon name="minus" size={17} class="faq-minus" />
              </summary>
              <div class="faq-answer">
                <p>{f.a}</p>
              </div>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ═══════════════════════ CTA ═══════════════════════ -->
  <section class="section cta-band">
    <div class="wrap">
      <div class="cta-inner grain">
        <div class="cta-text">
          <h2 class="cta-title">Not sure where to start?</h2>
          <p class="cta-lead">
            Answer five questions about when you are travelling, how long you have and what you
            actually enjoy — and get a shortlist from {stats.places} destinations.
          </p>
        </div>
        <div class="cta-actions">
          <a href="/discover" class="btn btn-primary">
            <Icon name="compass" size={16} /> Find my trip
          </a>
          <a href="/explore" class="btn btn-ghost">Browse everything</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ══════════════════════════ HERO ══════════════════════════ */
  .hero {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: center;
    min-height: min(46rem, 100svh);
    padding-block: 7rem 4.5rem;
    overflow: hidden;
    color: #f4f1e8;
  }
  .hero-art {
    position: absolute;
    inset: 0;
    z-index: -2;
  }
  :global(.hero-art-img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero-scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to right, rgb(5 20 18 / 0.94) 0%, rgb(5 20 18 / 0.78) 48%, rgb(5 20 18 / 0.42) 100%),
      linear-gradient(to top, rgb(5 20 18 / 0.8) 0%, rgb(5 20 18 / 0.2) 55%, transparent 80%);
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    max-width: 56rem;
  }

  .hero-kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgb(244 241 232 / 0.82);
    padding: 0.375rem 0.75rem 0.375rem 0.625rem;
    border: 1px solid rgb(244 241 232 / 0.22);
    border-radius: var(--radius-pill);
    backdrop-filter: blur(6px);
  }
  .hero-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-terracotta-400);
    box-shadow: 0 0 0 0 rgb(222 118 77 / 0.7);
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero-dot {
      animation: pulse 2.6s ease-out infinite;
    }
  }
  @keyframes pulse {
    70% {
      box-shadow: 0 0 0 9px rgb(222 118 77 / 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgb(222 118 77 / 0);
    }
  }

  .hero-title {
    margin-top: 1.25rem;
    font-size: clamp(2.5rem, 7.2vw, 4.75rem);
    line-height: 1.02;
    letter-spacing: -0.032em;
    color: #fff;
    font-variation-settings: 'opsz' 144, 'WONK' 1;
  }
  .hero-title em {
    font-style: italic;
    color: var(--color-marigold-300);
  }

  .hero-lead {
    margin-top: 1.25rem;
    max-width: 40rem;
    font-size: clamp(1rem, 1.7vw, 1.1875rem);
    line-height: 1.62;
    color: rgb(244 241 232 / 0.88);
  }

  .hero-search {
    margin-top: 2rem;
    max-width: 34rem;
  }
  .hero-search-btn {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    width: 100%;
    padding: 0.9375rem 0.9375rem 0.9375rem 1.125rem;
    border: 1px solid rgb(244 241 232 / 0.26);
    border-radius: var(--radius-pill);
    background: rgb(10 22 20 / 0.55);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    color: rgb(244 241 232 / 0.72);
    font-size: 0.9375rem;
    text-align: left;
    cursor: pointer;
    transition: border-color 0.18s, background-color 0.18s;
  }
  .hero-search-btn:hover {
    border-color: rgb(244 241 232 / 0.5);
    background: rgb(10 22 20 / 0.72);
  }
  .hero-search-btn span {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .hero-search-btn kbd {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    padding: 0.1875rem 0.4375rem;
    border: 1px solid rgb(244 241 232 / 0.24);
    border-radius: 5px;
  }

  .hero-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    margin: 1.25rem 0 0;
    padding: 0;
  }
  .hero-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.4375rem;
    padding: 0.5rem 0.875rem;
    border: 1px solid rgb(244 241 232 / 0.24);
    border-radius: var(--radius-pill);
    font-size: 0.875rem;
    font-weight: 550;
    color: rgb(244 241 232 / 0.92);
    backdrop-filter: blur(8px);
    transition: background-color 0.16s, border-color 0.16s, color 0.16s;
  }
  .hero-chip:hover {
    background: rgb(244 241 232 / 0.12);
    border-color: rgb(244 241 232 / 0.45);
  }
  .hero-chip-accent {
    background: var(--color-terracotta-600);
    border-color: var(--color-terracotta-600);
    color: #fff;
  }
  .hero-chip-accent:hover {
    background: var(--color-terracotta-500);
    border-color: var(--color-terracotta-500);
  }

  .hero-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem 2.5rem;
    margin: 2.5rem 0 0;
    padding-top: 1.75rem;
