---
import Base from '@/layouts/Base.astro';
import PageHero from '@components/PageHero.astro';
import SectionHead from '@components/SectionHead.astro';
import PlaceCard from '@components/PlaceCard.astro';
import Icon from '@components/Icon.astro';
import { seasons, placesInSeason, MONTHS, MONTHS_SHORT, placesInMonth } from '@data/index';

const trail = [
  { name: 'Home', href: '/' },
  { name: 'Seasons', href: '/seasons' },
];

const month = new Date().getMonth() + 1;
const currentSeason = seasons.find((s) => s.months.includes(month) && s.months.length <= 2)
  ?? seasons.find((s) => s.months.includes(month))!;

const rows = seasons.map((s) => ({
  season: s,
  count: placesInSeason(s.slug).length,
  picks: placesInSeason(s.slug).sort((a, b) => b.popularity - a.popularity).slice(0, 4),
}));

/* Month-by-month strip: how many destinations name each month as a good time. */
const byMonth = MONTHS.map((name, i) => ({
  name,
  short: MONTHS_SHORT[i],
  index: i + 1,
  count: placesInMonth(i + 1).length,
}));
const maxMonth = Math.max(...byMonth.map((m) => m.count));
---

<Base
  title="The best time to visit Bangladesh"
  description="Bangladesh runs on six seasons, not four, and travel here genuinely follows them. A month-by-month guide to when to go, what is only possible in the monsoon, and what winter opens up."
  path="/seasons"
  breadcrumbs={trail}
>
  <PageHero
    eyebrow="Six seasons"
    title="When to go, and why it matters more here"
    lead="The Bengali calendar counts six seasons, and this is not folklore — it is a practical travel constraint. Tanguar Haor is an inland sea in August and a paddy field in January. Ratargul is only navigable for four months. Kanchenjunga is visible for about six weeks a year."
    trail={trail}
  />

  <!-- ══════════ RIGHT NOW ══════════ -->
  <section class="section-tight now-band">
    <div class="wrap">
      <div class="now">
        <div class="now-text">
          <p class="eyebrow">Right now</p>
          <h2 class="now-title">
            It is {currentSeason.name} — <span lang="bn" class="bn">{currentSeason.nameBn}</span>
          </h2>
          <p class="now-lead">{currentSeason.tagline}</p>
          <a href={`/seasons/${currentSeason.slug}`} class="btn btn-primary">
            <Icon name="calendar" size={16} /> What is good in {currentSeason.name.toLowerCase()}
          </a>
        </div>
        <div class="now-months" role="img" aria-label={`${currentSeason.name} covers ${currentSeason.months.map((m) => MONTHS[m - 1]).join(', ')}`}>
          {
            MONTHS_SHORT.map((m, i) => (
              <span class:list={['now-month', { on: currentSeason.months.includes(i + 1), current: i + 1 === month }]}>
                {m}
              </span>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════ MONTH STRIP ══════════ -->
  <section class="section-tight">
    <div class="wrap">
      <SectionHead
        eyebrow="Month by month"
        title="How many places are at their best"
        lead="Each bar counts the destinations that name that month as a good time to visit. The dip in April and May is real: it is hot, hazy and pre-cyclone."
      />
      <ul class="month-chart">
        {
          byMonth.map((m) => (
            <li>
              <span class="month-bar-wrap">
                <span class="month-bar" style={`--h:${Math.round((m.count / maxMonth) * 100)}`}>
                  <span class="month-count tnum">{m.count}</span>
                </span>
              </span>
              <span class="month-label">{m.short}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ══════════ EACH SEASON ══════════ -->
  {
    rows.map(({ season, count, picks }) => (
      <section class="section-tight season-block">
        <div class="wrap">
          <div class="season-head">
            <div>
              <p class="eyebrow">
                {season.bengaliSeason} · <span lang="bn" class="bn">{season.nameBn}</span> ·{' '}
                {season.months.map((m) => MONTHS[m - 1]).join(' – ')}
              </p>
              <h2 class="season-title">
                <a href={`/seasons/${season.slug}`}>{season.name}</a>
              </h2>
              <p class="season-tagline">{season.tagline}</p>
            </div>
            <a href={`/seasons/${season.slug}`} class="season-link">
              {count} destinations <Icon name="arrowRight" size={15} />
            </a>
          </div>

          <p class="season-desc">{season.description}</p>

          <div class="season-cols">
            <div class="season-col season-good">
              <h3><Icon name="check" size={15} /> Good for</h3>
              <ul>{season.goodFor.map((g) => <li>{g}</li>)}</ul>
            </div>
            <div class="season-col season-watch">
              <h3><Icon name="alert" size={15} /> Watch out</h3>
              <ul>{season.watchOut.map((g) => <li>{g}</li>)}</ul>
            </div>
          </div>

          {picks.length > 0 && (
            <div class="rail season-rail">
              {picks.map((p) => (
                <PlaceCard place={p} variant="compact" />
              ))}
            </div>
          )}
        </div>
      </section>
    ))
  }
</Base>

<style>
  .now-band {
    background: var(--bg-sunken);
    border-bottom: 1px solid var(--line);
  }
  .now {
    display: grid;
    gap: 1.75rem;
    align-items: center;
  }
  @media (min-width: 56rem) {
    .now {
      grid-template-columns: 1fr minmax(18rem, 26rem);
      gap: 3rem;
    }
  }
  .now-title {
    margin-top: 0.5rem;
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    line-height: 1.1;
  }
  .now-title span {
    color: var(--accent);
  }
  .now-lead {
    margin-block: 0.75rem 1.25rem;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--fg-muted);
    max-width: 34rem;
  }
  .now-months {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 4px;
  }
  .now-month {
    padding: 0.625rem 0.25rem;
    text-align: center;
    font-size: 0.75rem;
    font-weight: 600;
    border-radius: 6px;
    background: var(--bg-raised);
    border: 1px solid var(--line);
    color: var(--fg-subtle);
  }
  .now-month.on {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--accent-fg);
  }
  .now-month.current {
    outline: 2px solid var(--ring);
    outline-offset: 2px;
  }

  .month-chart {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 0.375rem;
    list-style: none;
    margin: 0;
    padding: 0;
    align-items: end;
  }
  .month-chart li {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4375rem;
  }
  .month-bar-wrap {
    display: flex;
    align-items: flex-end;
    height: 9rem;
    width: 100%;
  }
  .month-bar {
    position: relative;
    width: 100%;
    height: calc(var(--h) * 1%);
    min-height: 0.5rem;
    border-radius: 5px 5px 0 0;
    background: linear-gradient(to top, var(--color-delta-600), var(--color-delta-400));
  }
  .month-count {
    position: absolute;
    top: -1.25rem;
    left: 50%;
    transform: translateX(-50%);
    font-size: 0.6875rem;
    font-weight: 700;
    color: var(--fg-subtle);
  }
  .month-label {
    font-size: 0.6875rem;
    font-weight: 600;
    color: var(--fg-subtle);
  }
  @media (max-width: 40rem) {
    .month-count {
      display: none;
    }
    .month-label {
      font-size: 0.5625rem;
    }
  }

  .season-block + .season-block {
    border-top: 1px solid var(--line);
  }
  .season-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem 2rem;
  }
  .season-title {
    margin-top: 0.375rem;
    font-size: clamp(1.5rem, 3.4vw, 2.25rem);
    line-height: 1.1;
  }
  .season-title a:hover {
    color: var(--accent);
  }
  .season-tagline {
    margin-top: 0.375rem;
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.0625rem;
    color: var(--accent);
  }
  .season-link {
    display: inline-flex;
    align-items: center;
    min-height: 24px;
    gap: 0.375rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--accent);
    white-space: nowrap;
  }
  .season-link:hover {
    gap: 0.5rem;
  }

  .season-desc {
    margin-top: 1rem;
    max-width: 52rem;
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--fg-muted);
  }

  .season-cols {
    display: grid;
    gap: 1rem;
    margin-top: 1.5rem;
  }
  @media (min-width: 44rem) {
    .season-cols {
      grid-template-columns: 1fr 1fr;
      gap: 1.25rem;
    }
  }
  .season-col {
    padding: 1rem 1.125rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    background: var(--bg-raised);
  }
  .season-col h3 {
    display: flex;
    align-items: center;
    gap: 0.4375rem;
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-bottom: 0.625rem;
  }
  .season-good h3 {
    color: var(--color-delta-500);
  }
  .season-watch h3 {
    color: var(--color-terracotta-600);
  }
  .season-col ul {
    margin: 0;
    padding-left: 1.0625rem;
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }
  .season-col li {
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--fg-muted);
  }

  .season-rail {
    margin-top: 1.5rem;
  }
</style>
