---
import type { GetStaticPaths } from 'astro';
import Base from '@/layouts/Base.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import Art from '@components/Art.astro';
import Icon from '@components/Icon.astro';
import PlaceCard from '@components/PlaceCard.astro';
import FavButton from '@components/FavButton.astro';
import BangladeshMap from '@components/BangladeshMap.astro';
import SectionHead from '@components/SectionHead.astro';
import {
  places,
  getDistrict,
  getDivision,
  getCategory,
  getTag,
  relatedPlaces,
  nearbyPlaces,
  seasonBySlug,
  MONTHS_SHORT,
} from '@data/index';
import { placeLd, placeTitle, artPath, clamp } from '@lib/seo';
import type { IconKey } from '@lib/types';

export const getStaticPaths = (() =>
  places.map((place) => ({ params: { place: place.slug }, props: { place } }))) satisfies GetStaticPaths;

const { place } = Astro.props;

const district = getDistrict(place.district)!;
const division = getDivision(place.division)!;
const primary = getCategory(place.categories[0]);
const otherCategories = place.categories.slice(1).map(getCategory).filter(Boolean);
const related = relatedPlaces(place, 6);
const nearby = nearbyPlaces(place, 6, 90).filter((n) => !related.some((r) => r.slug === n.slug)).slice(0, 4);
const seasons = (place.seasons ?? []).map((s) => seasonBySlug.get(s)).filter(Boolean);

const trail = [
  { name: 'Home', href: '/' },
  { name: division.name, href: `/divisions/${division.slug}` },
  { name: district.name, href: `/districts/${district.slug}` },
  { name: place.name, href: `/places/${place.slug}` },
];

const art = artPath(place.art, 'day');

const ENTRY_LABEL: Record<string, string> = {
  free: 'Free to enter',
  ticketed: 'Ticket required',
  permit: 'Permit or escort required',
  restricted: 'Restricted access',
  unknown: 'Entry terms unconfirmed',
};

const ENTRY_ICON: Record<string, IconKey> = {
  free: 'check',
  ticketed: 'ticket',
  permit: 'shield',
  restricted: 'alert',
  unknown: 'info',
};

const PRECISION_NOTE: Record<string, string> = {
  exact: 'Coordinates are for the site itself.',
  approx: 'Coordinates are accurate to within a few kilometres.',
  area: 'This is a representative point for a large or diffuse area, not a single location.',
};

const MODE_LABEL: Record<string, string> = {
  bus: 'Bus',
  train: 'Train',
  launch: 'Launch',
  boat: 'Boat',
  flight: 'Flight',
  car: 'Car',
  cng: 'CNG',
  rickshaw: 'Rickshaw',
  walk: 'On foot',
  ferry: 'Ferry',
  trek: 'Trek',
};

/* Quick-facts rail — only rows we actually have data for. */
const facts: { icon: IconKey; label: string; value: string; href?: string }[] = [];
if (primary) facts.push({ icon: primary.icon, label: 'Type', value: primary.name, href: `/categories/${primary.slug}` });
facts.push({ icon: 'pin', label: 'District', value: district.name, href: `/districts/${district.slug}` });
if (place.upazila) facts.push({ icon: 'map', label: 'Upazila', value: place.upazila });
if (place.duration) facts.push({ icon: 'clock', label: 'Time needed', value: place.duration.label });
if (place.tripLength) {
  const tripLabels: Record<string, string> = {
    'half-day': 'Half day',
    day: 'Day trip',
    overnight: 'Overnight',
    'multi-day': 'Multi-day',
  };
  facts.push({ icon: 'calendar', label: 'Trip length', value: tripLabels[place.tripLength] ?? place.tripLength });
}
if (place.entry) facts.push({ icon: ENTRY_ICON[place.entry.type], label: 'Entry', value: ENTRY_LABEL[place.entry.type] });
if (place.nearestHub) facts.push({ icon: 'bed', label: 'Nearest hub', value: place.nearestHub });
if (place.period) facts.push({ icon: 'scroll', label: 'Period', value: place.period });

const bestMonths = new Set(place.bestTime?.months ?? []);

const description = clamp(`${place.tagline} ${place.summary}`, 158);

const jsonLd = [placeLd(place, district, art)];
---

<Base
  title={placeTitle(place, district)}
  description={description}
  path={`/places/${place.slug}`}
  image={art}
  breadcrumbs={trail}
  jsonLd={jsonLd}
  bodyClass="place-page"
  transparentHeader
>
  <div data-record-visit={place.slug} data-record-name={place.name} hidden></div>

  <!-- ══════════════════ HERO ══════════════════ -->
  <header class="phero">
    <div class="phero-art">
      <Art art={place.art} alt="" loading="eager" priority ratio="16 / 9" class="phero-img" />
      <div class="phero-scrim"></div>
    </div>

    <div class="wrap phero-inner">
      <Breadcrumbs trail={trail} invert class="phero-crumbs" />

      <div class="phero-badges">
        {place.unesco && <span class="pbadge pbadge-unesco"><Icon name="star" size={13} /> UNESCO World Heritage</span>}
        {place.hiddenGem && <span class="pbadge pbadge-gem"><Icon name="sparkle" size={13} /> Hidden gem</span>}
        {primary && <a href={`/categories/${primary.slug}`} class="pbadge pbadge-cat"><Icon name={primary.icon} size={13} /> {primary.name}</a>}
      </div>

      <h1 class="phero-title">{place.name}</h1>
      <p class="phero-bn bn" lang="bn">{place.nameBn}</p>
      {place.altNames?.length && <p class="phero-alt">Also known as {place.altNames.join(', ')}</p>}

      <p class="phero-tagline">{place.tagline}</p>

      <div class="phero-where">
        <Icon name="pin" size={15} />
        <span>
          {place.locationNote ?? `${place.upazila ? place.upazila + ', ' : ''}${district.name}`}
          {' · '}
          <a href={`/districts/${district.slug}`}>{district.name}</a>
          {' · '}
          <a href={`/divisions/${division.slug}`}>{division.name}</a>
        </span>
      </div>

      <div class="phero-actions">
        <FavButton slug={place.slug} name={place.name} variant="full" class="phero-fav" />
        <button
          type="button"
          class="btn btn-ghost phero-share"
          data-share
          data-share-title={`${place.name} — Ghuro Bangladesh`}
          data-share-url={`https://ghurobangladesh.com/places/${place.slug}`}
        >
          <Icon name="share" size={16} />
          <span data-copy-label>Share</span>
        </button>
        {
          place.coords && (
            <a
              class="btn btn-ghost"
              href={`https://www.google.com/maps/search/?api=1&query=${place.coords.lat},${place.coords.lng}`}
              target="_blank"
              rel="noopener noreferrer"
            >
              <Icon name="map" size={16} /> Open in Maps
              <Icon name="external" size={13} />
            </a>
          )
        }
      </div>
    </div>
  </header>

  <!-- ══════════════════ QUICK FACTS ══════════════════ -->
  <section class="pfacts" aria-label="Key facts">
    <div class="wrap">
      <ul class="pfacts-list">
        {
          facts.map((f) => (
            <li class="pfact">
              <span class="pfact-icon">
                <Icon name={f.icon} size={16} />
              </span>
              <span class="pfact-text">
                <span class="pfact-label">{f.label}</span>
                {f.href ? (
                  <a href={f.href} class="pfact-value">
                    {f.value}
                  </a>
                ) : (
                  <span class="pfact-value">{f.value}</span>
                )}
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ══════════════════ BODY ══════════════════ -->
  <div class="wrap pbody">
    <article class="pmain">
      <!-- Why visit -->
      <section class="pwhy" aria-labelledby="why-title">
        <h2 id="why-title" class="pwhy-title">Why go</h2>
        <p class="pwhy-text">{place.whyVisit}</p>
      </section>

      <!-- Overview -->
      <section class="psection" aria-labelledby="overview-title">
        <h2 id="overview-title" class="psection-title">Overview</h2>
        <div class="prose-atlas">
          {place.description.map((para) => <p set:html={para.replace(/\*([^*]+)\*/g, '<em>$1</em>')} />)}
        </div>
      </section>

      <!-- Highlights -->
      {
        place.highlights?.length && (
          <section class="psection" aria-labelledby="highlights-title">
            <h2 id="highlights-title" class="psection-title">Highlights</h2>
            <ul class="plist plist-check">
              {place.highlights.map((h) => (
                <li>
                  <Icon name="check" size={15} />
                  <span>{h}</span>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      <!-- See / Do -->
      {
        (place.see?.length || place.do?.length) && (
          <section class="psection" aria-labelledby="seedo-title">
            <h2 id="seedo-title" class="psection-title">What to see and do</h2>
            <div class="pseedo">
              {place.see?.length && (
                <div class="pseedo-col">
                  <h3 class="pseedo-head">
                    <Icon name="eye" size={16} /> Things to see
                  </h3>
                  <ul class="plist plist-dot">
                    {place.see.map((s) => (
                      <li>{s}</li>
                    ))}
                  </ul>
                </div>
              )}
              {place.do?.length && (
                <div class="pseedo-col">
                  <h3 class="pseedo-head">
                    <Icon name="compass" size={16} /> Things to do
                  </h3>
                  <ul class="plist plist-dot">
                    {place.do.map((s) => (
                      <li>{s}</li>
                    ))}
                  </ul>
                </div>
              )}
            </div>
          </section>
        )
      }

      <!-- Best time -->
      {
        place.bestTime && (
          <section class="psection" aria-labelledby="when-title">
            <h2 id="when-title" class="psection-title">When to go</h2>
            <div class="pmonths" role="img" aria-label={`Best months: ${place.bestTime.months.map((m) => MONTHS_SHORT[m - 1]).join(', ')}`}>
              {MONTHS_SHORT.map((m, i) => (
                <span class:list={['pmonth', { good: bestMonths.has(i + 1) }]}>{m}</span>
              ))}
            </div>
            <p class="pwhen-note">{place.bestTime.note}</p>
            {seasons.length > 0 && (
              <p class="pseason-links">
                Season guides:{' '}
                {seasons.map((s, i) => (
                  <>
                    {i > 0 && ', '}
                    <a href={`/seasons/${s!.slug}`}>{s!.name}</a>
                  </>
                ))}
              </p>
            )}
          </section>
        )
      }

      <!-- Getting there -->
      {
        place.routes?.length && (
          <section class="psection" aria-labelledby="how-title">
            <h2 id="how-title" class="psection-title">How to get there</h2>
            <ol class="proutes">
              {place.routes.map((leg, i) => (
                <li class="proute">
                  <span class="proute-num tnum">{i + 1}</span>
                  <div class="proute-body">
                    <p class="proute-head">
                      <span class="proute-from">{leg.from}</span>
                      <Icon name="arrowRight" size={14} class="proute-arrow" />
                      <span class="proute-to">{leg.to}</span>
                    </p>
                    <p class="proute-modes">
                      {leg.modes.map((m) => (
                        <span class="proute-mode">{MODE_LABEL[m] ?? m}</span>
                      ))}
                      {leg.hours && (
                        <span class="proute-hours">
                          <Icon name="clock" size={12} />
                          {leg.hours[0] === leg.hours[1]
                            ? `${leg.hours[0]} hr`
                            : `${leg.hours[0]}–${leg.hours[1]} hr`}
                        </span>
                      )}
                    </p>
                    <p class="proute-note">{leg.note}</p>
                  </div>
                </li>
              ))}
            </ol>
          </section>
        )
      }

      <!-- Tips -->
      {
        place.tips?.length && (
          <section class="psection" aria-labelledby="tips-title">
            <h2 id="tips-title" class="psection-title">Practical tips</h2>
            <ul class="plist plist-tip">
              {place.tips.map((t) => (
                <li>
                  <Icon name="bulb" size={15} />
                  <span>{t}</span>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      <!-- Safety -->
      {
        place.safety?.length && (
          <section class="psection psafety" aria-labelledby="safety-title">
            <h2 id="safety-title" class="psection-title psafety-title">
              <Icon name="alert" size={18} /> Safety
            </h2>
            <ul class="plist plist-dot">
              {place.safety.map((s) => (
                <li>{s}</li>
              ))}
            </ul>
          </section>
        )
      }

      <!-- Accessibility, stay, eat -->
      {
        (place.accessibility?.length || place.stay || place.eat) && (
          <section class="psection" aria-labelledby="practical-title">
            <h2 id="practical-title" class="psection-title">On the ground</h2>
            <dl class="pground">
              {place.accessibility?.length && (
                <div>
                  <dt>
                    <Icon name="users" size={15} /> Accessibility
                  </dt>
                  <dd>{place.accessibility.join(' ')}</dd>
                </div>
              )}
              {place.stay && (
                <div>
                  <dt>
                    <Icon name="bed" size={15} /> Where to stay
                  </dt>
                  <dd>{place.stay}</dd>
                </div>
              )}
              {place.eat && (
                <div>
                  <dt>
                    <Icon name="basket" size={15} /> What to eat
                  </dt>
                  <dd>{place.eat}</dd>
                </div>
              )}
              {place.hours && (
                <div>
                  <dt>
                    <Icon name="clock" size={15} /> Opening hours
                  </dt>
                  <dd>{place.hours}</dd>
                </div>
              )}
              {place.entry?.note && (
                <div>
                  <dt>
                    <Icon name={ENTRY_ICON[place.entry.type]} size={15} /> Entry
                  </dt>
                  <dd>{place.entry.note}</dd>
                </div>
              )}
              {place.website && (
                <div>
                  <dt>
                    <Icon name="link" size={15} /> Official site
                  </dt>
                  <dd>
                    <a href={place.website} target="_blank" rel="noopener noreferrer">
                      {place.website.replace(/^https?:\/\//, '')} <Icon name="external" size={12} />
                    </a>
                  </dd>
                </div>
              )}
            </dl>
          </section>
        )
      }

      <!-- Videos -->
      {
        place.videos?.length && (
          <section class="psection" aria-labelledby="video-title">
            <h2 id="video-title" class="psection-title">Video</h2>
            <div class="pvideos">
              {place.videos.map((v) => (
                <figure class="pvideo">
                  <div class="pvideo-frame">
                    <iframe
                      src={`https://www.youtube-nocookie.com/embed/${v.id}`}
                      title={v.title}
                      loading="lazy"
                      referrerpolicy="strict-origin-when-cross-origin"
                      allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                      allowfullscreen
                    />
                  </div>
                  <figcaption>
                    {v.title}
                    {v.credit && <span class="pvideo-credit"> · {v.credit}</span>}
                  </figcaption>
                </figure>
              ))}
            </div>
          </section>
        )
      }

      <!-- Honesty note -->
      {
        place.unverified?.length && (
          <aside class="punverified" aria-label="What we could not verify">
            <p class="punverified-head">
              <Icon name="info" size={15} /> What we could not confirm
            </p>
            <ul>
              {place.unverified.map((u) => (
                <li>{u}</li>
              ))}
            </ul>
          </aside>
        )
      }
    </article>

    <!-- ══════════════════ SIDEBAR ══════════════════ -->
    <aside class="paside">
      <div class="pside-sticky">
        <!-- Map -->
        <section class="pside-card" aria-labelledby="map-title">
          <h2 id="map-title" class="pside-title">
            <Icon name="map" size={15} /> Where it is
          </h2>
          <div class="pside-map">
            <BangladeshMap
              level="districts"
              focus={district.slug}
              markers={[place]}
              interactive={false}
              choropleth={false}
            />
          </div>
          <p class="pside-place">
            <strong>{district.name}</strong> district, {division.name} division
          </p>
          {
            place.coords && (
              <>
                <p class="pside-coords tnum">
                  {place.coords.lat.toFixed(4)}° N, {place.coords.lng.toFixed(4)}° E
                </p>
                {place.coordPrecision && (
                  <p class="pside-precision">{PRECISION_NOTE[place.coordPrecision]}</p>
                )}
              </>
            )
          }
          <a href={`/districts/${district.slug}`} class="pside-link">
            All {district.name} destinations <Icon name="arrowRight" size={14} />
          </a>
        </section>

        <!-- Tags -->
        {
          place.tags.length > 0 && (
            <section class="pside-card" aria-labelledby="tags-title">
              <h2 id="tags-title" class="pside-title">
                <Icon name="filter" size={15} /> Good for
              </h2>
              <ul class="pside-tags">
                {place.tags.map((t) => {
                  const tag = getTag(t);
                  return tag ? (
                    <li>
                      <a href={`/tags/${tag.slug}`} class="chip">
                        {tag.name}
                      </a>
                    </li>
                  ) : null;
                })}
              </ul>
            </section>
          )
        }

        <!-- Categories -->
        {
          otherCategories.length > 0 && (
            <section class="pside-card" aria-labelledby="cats-title">
              <h2 id="cats-title" class="pside-title">
                <Icon name="grid" size={15} /> Also
              </h2>
              <ul class="pside-tags">
                {otherCategories.map((c) => (
                  <li>
                    <a href={`/categories/${c!.slug}`} class="chip">
                      {c!.name}
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          )
        }

        <!-- Nearby -->
        {
          nearby.length > 0 && (
            <section class="pside-card" aria-labelledby="nearby-title">
              <h2 id="nearby-title" class="pside-title">
                <Icon name="compass" size={15} /> Nearby
              </h2>
              <ul class="pside-nearby">
                {nearby.map((n) => (
                  <li>
                    <a href={`/places/${n.slug}`}>
                      <span class="pside-nearby-name">{n.name}</span>
                      <span class="pside-nearby-km tnum">
                        {n.km < 10 ? n.km.toFixed(1) : Math.round(n.km)} km
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          )
        }
      </div>
    </aside>
  </div>

  <!-- ══════════════════ RELATED ══════════════════ -->
  {
    related.length > 0 && (
      <section class="section related-band" aria-labelledby="related-title">
        <div class="wrap">
          <SectionHead
            eyebrow="Keep going"
            title="Related destinations"
            lead={`Places that pair naturally with ${place.name} — by geography, by theme, or because they are on the same road.`}
            href={`/districts/${district.slug}`}
            linkLabel={`More in ${district.name}`}
          />
          <div class="grid-cards">
            {related.map((r) => (
              <PlaceCard place={r} />
            ))}
          </div>
        </div>
      </section>
    )
  }
</Base>

<style>
  /* ══════════════════ HERO ══════════════════ */
  .phero {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: flex-end;
    min-height: min(34rem, 82svh);
    padding-block: 7rem 2.75rem;
    color: #f4f1e8;
    overflow: hidden;
  }
  .phero-art {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  :global(.phero-img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .phero-scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to top, rgb(5 18 16 / 0.95) 0%, rgb(5 18 16 / 0.72) 34%, rgb(5 18 16 / 0.28) 68%),
      linear-gradient(to right, rgb(5 18 16 / 0.72), rgb(5 18 16 / 0.24) 62%, transparent 100%);
  }
  .phero-inner {
    position: relative;
    width: 100%;
  }
  :global(.phero-crumbs) {
    margin-bottom: 1.625rem;
  }

  .phero-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4375rem;
    margin-bottom: 0.875rem;
  }
  .pbadge {
    display: inline-flex;
    align-items: center;
    gap: 0.3125rem;
    padding: 0.3125rem 0.625rem;
    border-radius: var(--radius-pill);
    font-size: 0.75rem;
    font-weight: 600;
    backdrop-filter: blur(8px);
  }
  .pbadge-unesco {
    background: rgb(255 255 255 / 0.94);
    color: #1a3a5c;
  }
  .pbadge-gem {
    background: color-mix(in oklab, var(--color-marigold-400) 94%, transparent);
    color: #38220a;
  }
  .pbadge-cat {
    background: rgb(244 241 232 / 0.16);
    border: 1px solid rgb(244 241 232 / 0.3);
    color: #f4f1e8;
  }
  .pbadge-cat:hover {
    background: rgb(244 241 232 / 0.28);
  }

  .phero-title {
    font-size: clamp(2.25rem, 6vw, 4rem);
    line-height: 1.03;
    letter-spacing: -0.03em;
    color: #fff;
    max-width: 20ch;
    font-variation-settings: 'opsz' 144, 'WONK' 1;
  }
  .phero-bn {
    margin-top: 0.375rem;
    font-size: clamp(1rem, 2vw, 1.375rem);
    color: rgb(244 241 232 / 0.78);
  }
  .phero-alt {
    margin-top: 0.25rem;
    font-size: 0.8125rem;
    color: rgb(244 241 232 / 0.6);
  }
  .phero-tagline {
    margin-top: 1rem;
    max-width: 46rem;
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(1.0625rem, 2.1vw, 1.375rem);
    line-height: 1.45;
    color: var(--color-marigold-200);
  }
  .phero-where {
    display: flex;
    align-items: flex-start;
    gap: 0.4375rem;
    margin-top: 1rem;
    font-size: 0.875rem;
    color: rgb(244 241 232 / 0.82);
    line-height: 1.5;
  }
  .phero-where a {
    text-decoration: underline;
    text-underline-offset: 2px;
    text-decoration-color: rgb(244 241 232 / 0.4);
  }
  .phero-where a:hover {
    color: #fff;
  }

  .phero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.5rem;
  }
  .phero-actions :global(.btn-ghost),
  .phero-actions :global(.fav-btn.is-full) {
    border-color: rgb(244 241 232 / 0.34);
    color: #f4f1e8;
    background: rgb(10 22 20 / 0.35);
    backdrop-filter: blur(10px);
  }
  .phero-actions :global(.btn-ghost:hover),
  .phero-actions :global(.fav-btn.is-full:hover) {
    background: rgb(244 241 232 / 0.16);
