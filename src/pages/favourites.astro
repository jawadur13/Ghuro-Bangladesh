---
import Base from '@/layouts/Base.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import Icon from '@components/Icon.astro';
import PlaceCard from '@components/PlaceCard.astro';
import { featuredPlaces, hiddenGems } from '@data/index';

const trail = [
  { name: 'Home', href: '/' },
  { name: 'Saved places', href: '/favourites' },
];

const suggestions = [...featuredPlaces.slice(0, 3), ...hiddenGems.slice(0, 3)];
---

<Base
  title="Your saved places"
  description="The destinations you have saved, grouped by division. Stored on your own device — no account, nothing sent anywhere."
  path="/favourites"
  breadcrumbs={trail}
  noindex
>
  <div class="fv-shell" data-favourites-page>
    <div class="wrap">
      <Breadcrumbs trail={trail} />

      <header class="fv-head">
        <div>
          <p class="eyebrow">Saved</p>
          <h1 class="fv-title">
            Your places <span class="fv-count tnum" data-fav-total>0</span>
          </h1>
          <p class="fv-lead">
            Grouped by division so a long list reads like a plan. Everything here lives in this
            browser only — there is no account and nothing is sent anywhere.
          </p>
        </div>

        <div class="fv-tools" data-fav-tools hidden>
          <button type="button" class="btn btn-ghost btn-sm" data-fav-export>
            <Icon name="copy" size={14} /> Export
          </button>
          <label class="btn btn-ghost btn-sm fv-import">
            <Icon name="plus" size={14} /> Import
            <input type="file" accept="application/json,.json" data-fav-import hidden />
          </label>
          <button type="button" class="btn btn-ghost btn-sm fv-clear" data-fav-clear>
            <Icon name="close" size={14} /> Clear all
          </button>
        </div>
      </header>

      <p class="fv-status" data-fav-status role="status" aria-live="polite"></p>

      <div class="fv-list" data-fav-list hidden></div>

      <div class="fv-empty" data-fav-empty>
        <span class="fv-empty-icon">
          <Icon name="bookmark" size={26} />
        </span>
        <h2>Nothing saved yet</h2>
        <p>
          Tap the bookmark on any destination and it will appear here. Your list is stored locally
          and survives reloads — but it will not follow you to another browser or device, so use
          <strong>Export</strong> if you want to keep it.
        </p>
        <div class="fv-empty-actions">
          <a href="/explore" class="btn btn-primary">
            <Icon name="compass" size={15} /> Browse destinations
          </a>
          <a href="/discover" class="btn btn-ghost">Find my trip</a>
        </div>

        <section class="fv-suggest">
          <h3 class="fv-suggest-title">Start with these</h3>
          <div class="fv-suggest-grid">
            {suggestions.map((p) => <PlaceCard place={p} variant="row" />)}
          </div>
        </section>
      </div>

      <noscript>
        <p class="fv-noscript">
          Saved places need JavaScript, because the list lives in your browser rather than on a
          server. <a href="/explore">Browse all destinations</a> instead.
        </p>
      </noscript>
    </div>
  </div>
</Base>

<style>
  .fv-shell {
    padding-block: 5.5rem 3rem;
    min-height: 60svh;
  }
  .fv-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.25rem 2rem;
    margin-top: 1rem;
  }
  .fv-title {
    margin-top: 0.5rem;
    font-size: clamp(2rem, 5vw, 3rem);
    line-height: 1.05;
  }
  .fv-count {
    color: var(--accent);
  }
  .fv-lead {
    margin-top: 0.625rem;
    max-width: 42rem;
    font-size: 1rem;
    line-height: 1.65;
    color: var(--fg-muted);
  }
  .fv-tools {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .fv-import {
    cursor: pointer;
  }
  .fv-clear:hover {
    border-color: var(--color-terracotta-500);
    color: var(--color-terracotta-600);
  }

  .fv-status {
    margin-top: 0.875rem;
    font-size: 0.8125rem;
    color: var(--fg-subtle);
  }

  .fv-list {
    margin-top: 2rem;
  }
  :global(.fav-group) + :global(.fav-group) {
    margin-top: 2.25rem;
  }
  :global(.fav-group-title) {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--fg-subtle);
    margin-bottom: 0.875rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--line);
  }
  :global(.fav-group-title span) {
    color: var(--accent);
  }
  :global(.fav-items) {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 21rem), 1fr));
    gap: 0.75rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  :global(.fav-item) {
    position: relative;
    display: flex;
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    overflow: hidden;
    background: var(--bg-raised);
    transition: border-color 0.18s, box-shadow 0.18s;
  }
  :global(.fav-item:hover) {
    border-color: var(--line-strong);
    box-shadow: var(--shadow-card);
  }
  :global(.fav-link) {
    display: flex;
    gap: 0.875rem;
    flex: 1;
    min-width: 0;
  }
  :global(.fav-art) {
    width: 7rem;
    flex: none;
    object-fit: cover;
    background: var(--bg-inset);
  }
  :global(.fav-text) {
    display: flex;
    flex-direction: column;
    gap: 0.0625rem;
    padding: 0.75rem 0.5rem 0.75rem 0;
    min-width: 0;
  }
  :global(.fav-name) {
    font-family: var(--font-display);
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: 1.2;
  }
  :global(.fav-link:hover .fav-name) {
    color: var(--accent);
  }
  :global(.fav-where) {
    font-size: 0.75rem;
    color: var(--fg-subtle);
  }
  :global(.fav-blurb) {
    margin-top: 0.25rem;
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--fg-muted);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  :global(.fav-item-missing) {
    padding: 0.75rem 0.875rem;
    opacity: 0.7;
  }
  :global(.fav-remove) {
    flex: none;
    align-self: flex-start;
    display: grid;
    place-items: center;
    width: 1.875rem;
    height: 1.875rem;
    margin: 0.5rem 0.5rem 0 0;
    border: 1px solid transparent;
    border-radius: 50%;
    background: transparent;
    color: var(--fg-subtle);
    cursor: pointer;
    transition: all 0.16s;
  }
  :global(.fav-remove:hover) {
    border-color: var(--color-terracotta-500);
    color: var(--color-terracotta-600);
    background: var(--accent-soft);
  }
  :global(.fav-loading) {
    padding: 2rem 0;
    font-size: 0.9375rem;
    color: var(--fg-subtle);
  }

  .fv-empty {
    max-width: 46rem;
    margin-top: 2.5rem;
  }
  .fv-empty-icon {
    display: inline-grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 50%;
    border: 1px solid var(--line);
    background: var(--bg-sunken);
    color: var(--fg-subtle);
    margin-bottom: 1rem;
  }
  .fv-empty h2 {
    font-size: 1.5rem;
    margin-bottom: 0.5rem;
  }
  .fv-empty p {
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--fg-muted);
    max-width: 40rem;
  }
  .fv-empty strong {
    color: var(--fg);
  }
  .fv-empty-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.25rem;
  }
  .fv-suggest {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--line);
  }
  .fv-suggest-title {
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--fg-subtle);
    margin-bottom: 0.875rem;
  }
  .fv-suggest-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
    gap: 0.75rem;
  }

  .fv-noscript {
    margin-top: 1.5rem;
    padding: 1rem 1.125rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    background: var(--bg-sunken);
    font-size: 0.9375rem;
    color: var(--fg-muted);
  }
  .fv-noscript a {
    color: var(--accent);
    text-decoration: underline;
  }
</style>
