---
import Base from '@/layouts/Base.astro';
import BangladeshMap from '@components/BangladeshMap.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import Icon from '@components/Icon.astro';
import { divisions, districts, placesInDistrict, places, stats } from '@data/index';

const trail = [
  { name: 'Home', href: '/' },
  { name: 'Map', href: '/map' },
];

const rows = districts
  .map((d) => ({ district: d, count: placesInDistrict(d.slug).length }))
  .sort((a, b) => b.count - a.count || a.district.name.localeCompare(b.district.name));

const withCoords = places.filter((p) => p.coords);
---

<Base
  title="Interactive map of Bangladesh"
  description={`Explore all ${stats.places} destinations on an interactive map of Bangladesh — 64 districts, 8 divisions, shaded by how much there is to see.`}
  path="/map"
  breadcrumbs={trail}
  bodyClass="map-page"
>
  <div class="mp-shell">
    <div class="wrap mp-head">
      <Breadcrumbs trail={trail} />
      <div class="mp-head-row">
        <div>
          <h1 class="mp-title">The map</h1>
          <p class="mp-lead">
            Every district, shaded by how many destinations this atlas documents. Hover or tap a
            district to see what is there; use the division filter to narrow it down.
          </p>
        </div>
        <dl class="mp-stats">
          <div><dt>Destinations</dt><dd class="tnum">{stats.places}</dd></div>
          <div><dt>Mapped</dt><dd class="tnum">{withCoords.length}</dd></div>
          <div><dt>Districts</dt><dd class="tnum" data-map-count>{stats.districts}</dd></div>
        </dl>
      </div>

      <div class="mp-filter" data-map-filter role="group" aria-label="Filter by division">
        <button type="button" class="chip" data-division-filter="all" aria-pressed="true">
          All divisions
        </button>
        {
          divisions.map((d) => (
            <button type="button" class="chip" data-division-filter={d.slug} aria-pressed="false">
              {d.name}
            </button>
          ))
        }
      </div>
    </div>

    <div class="wrap mp-body">
      <div class="mp-map-wrap">
        <BangladeshMap level="districts" markers={withCoords} detail="full" />
        <p class="mp-hint">
          <Icon name="info" size={13} />
          Pin size reflects how well known a destination is. Gold pins are hidden gems.
        </p>
      </div>

      <aside class="mp-list-wrap">
        <h2 class="mp-list-title">Districts by destination count</h2>
        <ol class="mp-list">
          {
            rows.map(({ district, count }) => (
              <li data-map-list-item data-division={district.division}>
                <a href={`/districts/${district.slug}`}>
                  <span class="mp-list-name">{district.name}</span>
                  <span class="mp-list-div">{divisions.find((d) => d.slug === district.division)?.name}</span>
                  <span class="mp-list-count tnum">{count}</span>
                </a>
              </li>
            ))
          }
        </ol>
      </aside>
    </div>
  </div>
</Base>

<style>
  .mp-shell {
    padding-block: 5.5rem 3rem;
  }
  .mp-head-row {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem 2.5rem;
    margin-top: 1rem;
  }
  .mp-title {
    font-size: clamp(2rem, 5vw, 3rem);
    line-height: 1.05;
  }
  .mp-lead {
    margin-top: 0.625rem;
    max-width: 40rem;
    font-size: 1rem;
    line-height: 1.65;
    color: var(--fg-muted);
  }
  .mp-stats {
    display: flex;
    gap: 1.5rem 2rem;
    margin: 0;
  }
  .mp-stats dt {
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--fg-subtle);
  }
  .mp-stats dd {
    margin: 0.125rem 0 0;
    font-family: var(--font-display);
    font-size: 1.625rem;
    font-weight: 600;
    line-height: 1;
  }

  .mp-filter {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin-top: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
  }
  .mp-filter .chip {
    cursor: pointer;
  }

  .mp-body {
    display: grid;
    gap: 2rem;
    margin-top: 1.75rem;
    align-items: start;
  }
  @media (min-width: 62rem) {
    .mp-body {
      grid-template-columns: minmax(0, 1fr) 19rem;
      gap: 2.5rem;
    }
  }

  .mp-map-wrap {
    padding: 1rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    background: var(--bg-raised);
  }
  .mp-hint {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    margin-top: 0.75rem;
    font-size: 0.75rem;
    color: var(--fg-subtle);
  }

  .mp-list-wrap {
    min-width: 0;
  }
  @media (min-width: 62rem) {
    .mp-list-wrap {
      position: sticky;
      top: 5.5rem;
      max-height: calc(100svh - 7rem);
      display: flex;
      flex-direction: column;
    }
  }
  .mp-list-title {
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--fg-subtle);
    margin-bottom: 0.75rem;
  }
  .mp-list {
    list-style: none;
    margin: 0;
    padding: 0;
    overflow-y: auto;
    flex: 1;
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    background: var(--bg-raised);
  }
  .mp-list a {
    display: flex;
    align-items: baseline;
    gap: 0.625rem;
    padding: 0.5rem 0.875rem;
    border-bottom: 1px solid var(--line);
    font-size: 0.875rem;
  }
  .mp-list li:last-child a {
    border-bottom: 0;
  }
  .mp-list a:hover {
    background: var(--bg-sunken);
  }
  .mp-list a:hover .mp-list-name {
    color: var(--accent);
  }
  .mp-list-name {
    font-weight: 600;
    flex: none;
  }
  .mp-list-div {
    flex: 1;
    min-width: 0;
    font-size: 0.75rem;
    color: var(--fg-subtle);
    text-align: right;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .mp-list-count {
    flex: none;
    min-width: 1.5rem;
    text-align: right;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--fg-subtle);
  }
</style>
