---
import Icon from './Icon.astro';

interface Props {
  trail: { name: string; href: string }[];
  /** Render on a dark band. */
  invert?: boolean;
  class?: string;
}
const { trail, invert = false, class: className = '' } = Astro.props;
---

<nav class:list={['crumbs', { invert }, className]} aria-label="Breadcrumb">
  <ol>
    {
      trail.map((item, i) => (
        <li>
          {i < trail.length - 1 ? (
            <>
              <a href={item.href}>{item.name}</a>
              <Icon name="chevronRight" size={13} class="crumb-sep" />
            </>
          ) : (
            <span aria-current="page">{item.name}</span>
          )}
        </li>
      ))
    }
  </ol>
</nav>

<style>
  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.1875rem 0.375rem;
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 0.8125rem;
  }
  .crumbs li {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    min-width: 0;
  }
  .crumbs a,
  .crumbs span[aria-current] {
    /* Padding rather than font size: keeps the crumb visually small while
       giving it a 24px pointer target. */
    display: inline-flex;
    align-items: center;
    min-height: 24px;
    padding-block: 0.125rem;
  }
  .crumbs a {
    color: var(--fg-subtle);
    transition: color 0.16s;
    white-space: nowrap;
  }
  .crumbs a:hover {
    color: var(--accent);
  }
  .crumbs span[aria-current] {
    color: var(--fg-muted);
    font-weight: 550;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-width: 18rem;
  }
  :global(.crumb-sep) {
    color: var(--fg-subtle);
    opacity: 0.55;
  }

  .crumbs.invert a {
    color: rgb(244 241 232 / 0.68);
  }
  .crumbs.invert a:hover {
    color: #fff;
  }
  .crumbs.invert span[aria-current] {
    color: rgb(244 241 232 / 0.92);
  }
  .crumbs.invert :global(.crumb-sep) {
    color: rgb(244 241 232 / 0.5);
  }
</style>
