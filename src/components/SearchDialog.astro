---
import Icon from './Icon.astro';
import { stats } from '@data/index';
---

<dialog class="search-dialog" data-search-dialog aria-label="Search destinations">
  <div class="sd-panel">
    <form class="sd-field" role="search" action="/search" method="get" onsubmit="return false">
      <Icon name="search" size={19} class="sd-field-icon" />
      <input
        type="search"
        name="q"
        data-search-input
        placeholder={`Search ${stats.places} destinations, districts, categories…`}
        aria-label="Search destinations"
        autocomplete="off"
        autocorrect="off"
        autocapitalize="off"
        spellcheck="false"
        enterkeyhint="search"
      />
      <button type="button" class="sd-close" data-search-close aria-label="Close search">
        <Icon name="close" size={18} />
      </button>
    </form>

    <p class="sd-status sr-only" data-search-status role="status" aria-live="polite"></p>

    <div class="sd-results" data-search-results></div>

    <footer class="sd-foot">
      <span><kbd>↑</kbd><kbd>↓</kbd> navigate</span>
      <span><kbd>↵</kbd> open</span>
      <span><kbd>esc</kbd> close</span>
      <span class="sd-foot-hint">Bengali and older spellings both work</span>
    </footer>
  </div>
</dialog>

<style is:global>
  .search-dialog {
    width: min(42rem, calc(100vw - 1.5rem));
    max-width: none;
    max-height: min(38rem, calc(100vh - 4rem));
    margin: 0 auto;
    margin-top: max(3.5rem, 8vh);
    padding: 0;
    border: 0;
    background: transparent;
    overflow: visible;
  }
  .search-dialog::backdrop {
    background: color-mix(in oklab, var(--color-delta-950) 62%, transparent);
    backdrop-filter: blur(3px);
  }
  @media (prefers-reduced-motion: no-preference) {
    .search-dialog[open] {
      animation: sd-in 0.2s var(--ease-out-soft);
    }
    .search-dialog[open]::backdrop {
      animation: sd-fade 0.2s ease;
    }
  }
  @keyframes sd-in {
    from {
      opacity: 0;
      transform: translateY(-10px) scale(0.985);
    }
  }
  @keyframes sd-fade {
    from {
      opacity: 0;
    }
  }

  .sd-panel {
    display: flex;
    flex-direction: column;
    max-height: min(38rem, calc(100vh - 4rem));
    background: var(--bg-raised);
    border: 1px solid var(--line-strong);
    border-radius: 1rem;
    box-shadow: var(--shadow-pop);
    overflow: hidden;
  }

  .sd-field {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.875rem 0.875rem 0.875rem 1.125rem;
    border-bottom: 1px solid var(--line);
    flex: none;
  }
  .sd-field-icon {
    color: var(--fg-subtle);
  }
  .sd-field input {
    flex: 1;
    min-width: 0;
    border: 0;
    background: transparent;
    font-size: 1.0625rem;
    outline: none;
    color: var(--fg);
  }
  .sd-field input::placeholder {
    color: var(--fg-subtle);
  }
  .sd-field input::-webkit-search-cancel-button {
    -webkit-appearance: none;
  }
  .sd-close {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--fg-subtle);
    cursor: pointer;
  }
  .sd-close:hover {
    color: var(--fg);
    background: var(--bg-sunken);
  }

  .sd-results {
    flex: 1;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 0.5rem;
  }

  .sr-group + .sr-group {
    margin-top: 1rem;
  }
  .sr-group-title {
    padding: 0.5rem 0.625rem 0.375rem;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--fg-subtle);
  }

  .sr-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    padding: 0.25rem 0.625rem 0.5rem;
  }

  .sr-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .sr-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.5rem 0.625rem;
    border-radius: 0.625rem;
    transition: background-color 0.12s;
  }
  .sr-item.active,
  .sr-item:hover {
    background: var(--accent-soft);
  }
  .sr-item.active .sr-name,
  .sr-item:hover .sr-name {
    color: var(--accent);
  }
  .sr-art {
    flex: none;
    width: 3.5rem;
    height: 2.5rem;
    object-fit: cover;
    border-radius: 0.375rem;
    background: var(--bg-inset);
  }
  .sr-text {
    display: flex;
    flex-direction: column;
    gap: 0.0625rem;
    min-width: 0;
    flex: 1;
  }
  .sr-name {
    font-weight: 600;
    font-size: 0.9375rem;
    line-height: 1.3;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .sr-name mark {
    background: color-mix(in oklab, var(--color-marigold-300) 65%, transparent);
    color: inherit;
    border-radius: 3px;
    padding: 0 1px;
  }
  .sr-sub {
    font-size: 0.75rem;
    color: var(--fg-subtle);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .sr-right {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    flex: none;
  }
  .sr-via {
    font-size: 0.6875rem;
    color: var(--fg-subtle);
    white-space: nowrap;
  }
  .sr-gem {
    font-size: 0.625rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 0.125rem 0.3125rem;
    border-radius: 4px;
    background: color-mix(in oklab, var(--color-marigold-400) 22%, transparent);
    color: var(--color-marigold-600);
  }

  .sr-all {
    display: block;
    margin: 0.5rem 0.625rem 0.25rem;
    padding: 0.625rem;
    border-radius: 0.625rem;
    border: 1px dashed var(--line-strong);
    text-align: center;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--fg-muted);
  }
  .sr-all:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .sr-empty {
    padding: 1.75rem 1rem 1.5rem;
    text-align: center;
  }
  .sr-empty-title {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 600;
    margin-bottom: 0.375rem;
  }
  .sr-empty-body {
    font-size: 0.875rem;
    color: var(--fg-muted);
    max-width: 26rem;
    margin: 0 auto 0.875rem;
    line-height: 1.6;
  }
  .sr-empty-body a {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .sr-empty .sr-chips {
    justify-content: center;
  }

  .sd-foot {
    flex: none;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.875rem;
    padding: 0.625rem 1rem;
    border-top: 1px solid var(--line);
    background: var(--bg-sunken);
    font-size: 0.75rem;
    color: var(--fg-subtle);
  }
  .sd-foot kbd {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    padding: 0.0625rem 0.3125rem;
    margin-right: 0.1875rem;
    border: 1px solid var(--line);
    border-radius: 4px;
    background: var(--bg-raised);
  }
  .sd-foot-hint {
    margin-left: auto;
  }

  @media (max-width: 40rem) {
    .search-dialog {
      width: 100vw;
      max-width: 100vw;
      max-height: 100dvh;
      margin: 0;
      height: 100dvh;
    }
    .sd-panel {
      max-height: 100dvh;
      height: 100dvh;
      border-radius: 0;
      border: 0;
    }
    .sd-foot-hint {
      display: none;
    }
  }
</style>
