---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { divisions, categoryGroups, categories, featuredTags, stats } from '@data/index';

interface Props {
  transparent?: boolean;
}
const { transparent = false } = Astro.props;

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path === href || path.startsWith(href + '/');

const nav = [
  { href: '/explore', label: 'Explore' },
  { href: '/divisions', label: 'Divisions' },
  { href: '/districts', label: 'Districts' },
  { href: '/categories', label: 'Categories' },
  { href: '/collections', label: 'Collections' },
  { href: '/map', label: 'Map' },
];

const groupedCategories = categoryGroups.map((g) => ({
  ...g,
  items: categories.filter((c) => c.group === g.slug),
}));
---

<header class:list={['site-header', { transparent }]} data-header>
  <div class="wrap header-inner">
    <a href="/" class="brand" aria-label={`${'Ghuro Bangladesh'} — home`}>
      <Logo size={32} wordmark />
    </a>

    <nav class="primary-nav" aria-label="Primary">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                class:list={['nav-link', { active: isActive(item.href) }]}
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="header-actions">
      <button type="button" class="search-trigger" data-search-open aria-label="Search destinations">
        <Icon name="search" size={17} />
        <span class="search-trigger-text">Search {stats.places} places</span>
        <kbd class="search-kbd">/</kbd>
      </button>

      <a href="/favourites" class="icon-btn" aria-label="Saved places" data-fav-link>
        <Icon name="bookmark" size={18} />
        <span class="fav-count" data-fav-count hidden></span>
      </a>

      <button type="button" class="icon-btn" data-theme-toggle aria-label="Switch theme">
        <Icon name="sun" size={18} class="icon-sun" />
        <Icon name="moon" size={18} class="icon-moon" />
      </button>

      <button
        type="button"
        class="icon-btn menu-btn"
        data-menu-toggle
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <Icon name="menu" size={20} class="icon-menu" />
        <Icon name="close" size={20} class="icon-close" />
      </button>
    </div>
  </div>
</header>

<!-- Mobile / overflow menu -->
<div class="mobile-menu" id="mobile-menu" data-menu hidden>
  <div class="wrap mobile-menu-inner">
    <section>
      <p class="eyebrow">Browse</p>
      <ul class="menu-links">
        {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        <li><a href="/discover">Where should I go?</a></li>
        <li><a href="/seasons">Best time to visit</a></li>
        <li><a href="/favourites">Saved places</a></li>
        <li><a href="/about">About</a></li>
      </ul>
    </section>

    <section>
      <p class="eyebrow">Divisions</p>
      <ul class="menu-grid">
        {
          divisions.map((d) => (
            <li>
              <a href={`/divisions/${d.slug}`}>
                <span>{d.name}</span>
                <span class="bn" lang="bn">
                  {d.nameBn}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section>
      <p class="eyebrow">By interest</p>
      <ul class="menu-chips">
        {featuredTags.map((t) => <li><a href={`/tags/${t.slug}`} class="chip">{t.name}</a></li>)}
      </ul>
    </section>

    <section>
      <p class="eyebrow">By category</p>
      {
        groupedCategories.map((g) => (
          <div class="menu-cat-group">
            <p class="menu-cat-title">{g.name}</p>
            <ul class="menu-chips">
              {g.items.map((c) => (
                <li>
                  <a href={`/categories/${c.slug}`} class="chip">
                    {c.name}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </section>
  </div>
</div>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 60;
    background: color-mix(in oklab, var(--bg) 88%, transparent);
    backdrop-filter: saturate(1.4) blur(14px);
    -webkit-backdrop-filter: saturate(1.4) blur(14px);
    border-bottom: 1px solid transparent;
    transition: border-color 0.25s, background-color 0.25s;
  }
  .site-header[data-scrolled] {
    border-bottom-color: var(--line);
  }
  .site-header.transparent:not([data-scrolled]) {
    background: transparent;
    backdrop-filter: none;
  }

  .header-inner {
    display: flex;
    align-items: center;
    gap: 1rem;
    height: 4.25rem;
  }

  .brand {
    flex: none;
    border-radius: 8px;
  }

  .primary-nav {
    display: none;
    flex: 1;
    min-width: 0;
  }
  .primary-nav ul {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav-link {
    display: block;
    padding: 0.5rem 0.75rem;
    border-radius: var(--radius-pill);
    font-size: 0.9375rem;
    font-weight: 550;
    color: var(--fg-muted);
    white-space: nowrap;
    transition: color 0.16s, background-color 0.16s;
  }
  .nav-link:hover {
    color: var(--fg);
    background: var(--bg-sunken);
  }
  .nav-link.active {
    color: var(--accent);
    background: var(--accent-soft);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    margin-left: auto;
  }

  .search-trigger {
    display: none;
    align-items: center;
    gap: 0.5rem;
    height: 2.375rem;
    padding: 0 0.5rem 0 0.75rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    background: var(--bg-raised);
    color: var(--fg-subtle);
    font-size: 0.875rem;
    cursor: pointer;
    transition: border-color 0.16s, color 0.16s, box-shadow 0.16s;
  }
  .search-trigger:hover {
    border-color: var(--fg-subtle);
    color: var(--fg-muted);
    box-shadow: var(--shadow-card);
  }
  .search-trigger-text {
    white-space: nowrap;
  }
  .search-kbd {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    padding: 0.125rem 0.375rem;
    border: 1px solid var(--line);
    border-radius: 5px;
    background: var(--bg-sunken);
    color: var(--fg-subtle);
    line-height: 1.4;
  }

  .icon-btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.375rem;
    height: 2.375rem;
    border: 1px solid transparent;
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--fg-muted);
    cursor: pointer;
    transition: background-color 0.16s, color 0.16s, border-color 0.16s;
  }
  .icon-btn:hover {
    background: var(--bg-sunken);
    color: var(--fg);
    border-color: var(--line);
  }

  .fav-count {
    position: absolute;
    top: 2px;
    right: 2px;
    min-width: 1.05rem;
    height: 1.05rem;
    padding: 0 0.25rem;
    border-radius: var(--radius-pill);
    background: var(--accent);
    color: var(--accent-fg);
    font-size: 0.625rem;
    font-weight: 700;
    line-height: 1.05rem;
    text-align: center;
  }

  /* Theme icons swap with the resolved theme */
  :global(.icon-moon) {
    display: none;
  }
  :global(:root[data-theme='dark']) :global(.icon-sun) {
    display: none;
  }
  :global(:root[data-theme='dark']) :global(.icon-moon) {
    display: block;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) :global(.icon-sun) {
      display: none;
    }
    :global(:root:not([data-theme='light'])) :global(.icon-moon) {
      display: block;
    }
  }

  :global(.icon-close) {
    display: none;
  }
  .menu-btn[aria-expanded='true'] :global(.icon-menu) {
    display: none;
  }
  .menu-btn[aria-expanded='true'] :global(.icon-close) {
    display: block;
  }

  /* ── Mobile menu ── */
  .mobile-menu {
    position: fixed;
    inset: 4.25rem 0 0;
    z-index: 55;
    background: var(--bg);
    overflow-y: auto;
    overscroll-behavior: contain;
    border-top: 1px solid var(--line);
    animation: menu-in 0.22s var(--ease-out-soft);
  }
  @keyframes menu-in {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
  }
  .mobile-menu-inner {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    padding-block: 1.75rem 4rem;
  }
  .mobile-menu .eyebrow {
    margin-bottom: 0.75rem;
  }
  .menu-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }
  .menu-links a {
    display: block;
    padding: 0.6875rem 0;
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    border-bottom: 1px solid var(--line);
  }
  .menu-links a:hover {
    color: var(--accent);
  }

  .menu-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.5rem;
  }
  .menu-grid a {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    padding: 0.625rem 0.75rem;
    border: 1px solid var(--line);
    border-radius: 0.625rem;
    font-weight: 600;
    font-size: 0.9375rem;
  }
  .menu-grid a:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .menu-grid .bn {
    font-size: 0.8125rem;
    font-weight: 400;
    color: var(--fg-subtle);
  }

  .menu-chips {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }
  .menu-cat-group + .menu-cat-group {
    margin-top: 1rem;
  }
  .menu-cat-title {
    font-size: 0.8125rem;
    font-weight: 650;
    color: var(--fg-muted);
    margin-bottom: 0.5rem;
  }

  @media (min-width: 56rem) {
    .search-trigger {
      display: inline-flex;
    }
  }
  @media (min-width: 68rem) {
    .primary-nav {
      display: block;
      margin-left: 0.75rem;
    }
    .menu-btn {
      display: none;
    }
    .mobile-menu {
      display: none;
    }
  }
</style>
